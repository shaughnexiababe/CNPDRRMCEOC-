<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The encrypted session cache must never be restored: keys are
             device-bound (Android Keystore), so a restored file is garbage
             anyway, and it contains user profile data. -->
        <exclude domain="sharedpref" path="pdrrmo_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pdrrmo_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
