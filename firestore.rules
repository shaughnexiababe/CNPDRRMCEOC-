rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return hasUserDoc() ? getUserData().get('role', 'citizen') : 'citizen';
    }

    function isStaff() {
      return isSignedIn() && (
        role() == 'eoc_personnel' || role() == 'admin' ||
        role() == 'EOC_PERSONNEL' || role() == 'ADMIN'
      );
    }

    function isAdmin() {
      return isSignedIn() && (role() == 'admin' || role() == 'ADMIN');
    }

    function isMdrrmo() {
      return isSignedIn() && (role() == 'mdrrmo' || role() == 'MDRRMO');
    }

    function myMuni() {
      return hasUserDoc() ? getUserData().get('municipality', '') : '';
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'citizen';

      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && (resource.data.role == 'citizen'
                            || request.resource.data.get('municipality', null) == resource.data.get('municipality', null)));

      allow delete: if isAdmin();
    }

    // ---------- incidents (Public-safe) ----------
    match /incidents/{incidentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.reported_by_id == request.auth.uid
                    && request.resource.data.status == 'reported'
                    && request.resource.data.keys().hasAny(['reporter_contact','reporter_name','reported_by_name','latitude','longitude','location','photo_urls']) == false;

      allow update: if isStaff()
                    || (isSignedIn()
                        && resource.data.reported_by_id == request.auth.uid
                        && resource.data.status == 'reported'
                        && request.resource.data.status == 'reported'
                        && request.resource.data.get('priority', null) == resource.data.get('priority', null)
                        && request.resource.data.reported_by_id == resource.data.reported_by_id
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','updated_at']));

      allow delete: if isAdmin();
    }

    // ---------- incidents_private (PII Locked) ----------
    match /incidents_private/{incidentId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.reported_by_id == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.reported_by_id == request.auth.uid
                    && getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data.reported_by_id == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // ---------- hazard alerts ----------
    match /hazard_alerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- response units ----------
    match /units/{unitId} {
      allow read: if isStaff();

      allow write: if isStaff();
      allow update: if isSignedIn() && resource.data.crew_lead_user_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['current_location', 'last_location_update', 'updated_at']);

      match /location_history/{recordId} {
        allow read: if isStaff();
        allow create: if isStaff()
                      || (isSignedIn()
                          && get(/databases/$(database)/documents/units/$(unitId)).data.crew_lead_user_id == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ---------- assignments ----------
    match /assignments/{assignmentId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- facilities ----------
    match /facilities/{facilityId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- hazard layers (GIS datasets) ----------
    match /hazard_layers/{layerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- barangay assessments ----------
    match /barangay_assessments/{docId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- shift notes ----------
    match /shift_notes/{noteId} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ---------- "I'm safe" check-ins ----------
    match /checkins/{checkinId} {
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      allow update, delete: if isAdmin();
    }

    // ---------- NDRRMC situational reporting (MC 05, s. 2025) ----------
    match /operations/{opId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isStaff() || request.resource.data.created_by == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdmin();

      match /reports/{reportId} {
        function ownsReport() {
          return isMdrrmo() && resource.data.municipality == myMuni();
        }

        allow read: if isStaff()
                    || (isMdrrmo() && (resource == null || resource.data.municipality == myMuni()));

        allow create: if isStaff()
                      || (isMdrrmo()
                          && request.resource.data.municipality == myMuni()
                          && request.resource.data.status == 'draft'
                          && request.resource.data.report_no <=
                             get(/databases/$(database)/documents/operations/$(opId)).data.current_report_no);

        allow update: if isStaff()
                      || (ownsReport()
                          && resource.data.status in ['draft', 'returned']
                          && request.resource.data.municipality == resource.data.municipality
                          && request.resource.data.report_no == resource.data.report_no
                          && request.resource.data.status in ['draft', 'returned', 'submitted']);

        allow delete: if isAdmin();

        match /restricted/{docId} {
          function parent() {
            return get(/databases/$(database)/documents/operations/$(opId)/reports/$(reportId)).data;
          }

          allow read: if isStaff()
                      || (isMdrrmo() && parent().municipality == myMuni());

          allow write: if isStaff()
                       || (isMdrrmo()
                           && parent().municipality == myMuni()
                           && parent().status in ['draft', 'returned']);
        }
      }
    }

    // ---------- audit logs (Cloud Functions / Admin SDK only) ----------
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
